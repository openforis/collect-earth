<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="warn">

	<Appenders>
		<RollingFile name="file"
			fileName="${sys:collectEarth.userFolder}/earth_error.log"
			filePattern="${sys:collectEarth.userFolder}/earth_error_%d{MM-dd-yyyy}-%i.log"
			bufferedIO="true" bufferSize="8192">
			<PatternLayout pattern="%-5p %d [%t] %c: %m%n" />
			<Policies>
				<SizeBasedTriggeringPolicy size="10 MB" />
			</Policies>
			<DefaultRolloverStrategy max="5" />
			<!-- Filters can be appender-specific -->
		</RollingFile>

		<Console name="STDOUT" target="SYSTEM_OUT">
			<PatternLayout pattern="%-5p %d [%t] %c: %m%n" />
			<!-- Optional: You may define filters here -->
		</Console>


		<Sentry name="SENTRY" dsn="https://24dd6a90c1e4461484712db99c3b3bb7:831e42661c5c4ff3aa5eca270db3f619@sentry.io/299626">
			<!-- If specific filtering needed, define here -->
			
			<!-- Wrap all filters here.

			     NEUTRAL is what lets the next filter run. CompositeFilter returns as soon as a filter answers
			     ACCEPT or DENY, so the ACCEPT that used to be on the regex below ended the chain for every event
			     that was not a ConnectionException - which is every normal error - and the BurstFilter after it was
			     never consulted at all. -->
			<Filters>
				<RegexFilter
					regex=".*io.sentry.connection.ConnectionException.*" onMatch="DENY"
					onMismatch="NEUTRAL" />

				<!-- Rate limit, so one failing loop cannot empty itself into Sentry.

				     onMatch is the event that is ALLOWED: BurstFilter returns onMatch while it still has an event
				     left in its allowance, and onMismatch once the allowance is spent. The pair used to be the
				     other way round, which would have dropped the first five errors and reported every one after
				     them - suppressing the first sight of a problem and keeping the repeats. It never actually ran,
				     because of the ACCEPT above, so nothing was rate limited either.

				     rate=1 with maxBurst=5 lets five errors through at once, then one per second. FATAL is never
				     limited: its level is less specific than the configured ERROR, so it returns onMatch without
				     touching the allowance, and an uncaught crash is always reported. -->
				<BurstFilter level="ERROR"
					rate="1"
					maxBurst="5"
					onMatch="NEUTRAL"
					onMismatch="DENY"/>
			</Filters>
		</Sentry>
	</Appenders>

	<Loggers>
		<!-- Libraries that report at ERROR something that does not stop Collect Earth. It stays in the log file, and is
		     kept away from Sentry and from the error dialog, which both hang from the root logger (the dialog is added
		     to it by CollectEarthMenu) - additivity="false" is what keeps them out.
		     - SQLiteJDBCLoader cannot delete the copy of its DLL that an earlier run left in the temporary folder,
		       because another process - an antivirus, another Collect Earth - still holds it. The database works.
		     - WebDriverManager could not download a browser driver and falls back to one it already has. When that
		       fails too, BrowserService reports that no browser could be started. -->
		<Logger name="org.sqlite.SQLiteJDBCLoader" level="INFO" additivity="false">
			<AppenderRef ref="file" level="ERROR" />
			<AppenderRef ref="STDOUT" level="INFO" />
		</Logger>
		<Logger name="io.github.bonigarcia.wdm" level="INFO" additivity="false">
			<AppenderRef ref="file" level="ERROR" />
			<AppenderRef ref="STDOUT" level="INFO" />
		</Logger>
		<Root level="INFO">
			<AppenderRef ref="file" level="ERROR" />
			<AppenderRef ref="STDOUT" level="INFO" />
			<AppenderRef ref="SENTRY" level="ERROR" />
		</Root>
	</Loggers>
</Configuration>
