  },
  "devDependencies": {
    "@types/google.maps": "3.66.7",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
