(function () {
    // ===== Plot geometry from Collect Earth (lon, lat pairs in WGS84) =====
    // Outer rings = the plot polygon and any buffers (placemark.multiShape).
    // Inner rings = the sample squares (placemark.points[].shape).
    var rings = [
        <#list placemark.multiShape as shp>
        [
            <#list shp as coord>
            [${coord.longitude}, ${coord.latitude}]<#if coord?has_next>,</#if>
            </#list>
        ]<#if shp?has_next>,</#if>
        </#list>
        <#if placemark.points??>
            <#list placemark.points as square>
            ,[
                <#list square.shape as sc>
                [${sc.longitude}, ${sc.latitude}]<#if sc?has_next>,</#if>
                </#list>
            ]
            </#list>
        </#if>
    ];
    var plotCenter = [${longitude}, ${latitude}];
    var PLOT_TAG = "collectEarthPlot";

    // ===== 0) Stop what an earlier injection into this page left running =====
    // Its cookie poll, its search for the map and its watchers, which would redraw the plot before this one
    var CE_TAG = "__collectEarthWaybackOverlay";
    if (window[CE_TAG] && window[CE_TAG].stop) {
        try { window[CE_TAG].stop(); } catch (e) { /* ignore */ }
    }
    var stopped = false;
    var watchHandles = [];
    var extentPoll = null;
    var drawnOn = null; // the view the plot was drawn on as graphics
    window[CE_TAG] = {
        stop: function () {
            stopped = true;
            clearInterval(cookiePoll);
            clearInterval(poll);
            clearInterval(extentPoll);
            // The plot before this one, which the page still shows if the next one cannot be drawn
            if (drawnOn) removeGraphics(drawnOn);
            watchHandles.forEach(function (h) { try { h.remove(); } catch (e) { /* ignore */ } });
            watchHandles = [];
        }
    };

    // ===== 1) Auto-accept cookie banners (idempotent, fire-and-forget) =====
    function clickCookieBanners() {
        var selectors = [
            "#onetrust-accept-btn-handler",
            "button#onetrust-accept-btn-handler",
            ".onetrust-close-btn-handler",
            "button.optanon-allow-all",
            "#accept-recommended-btn-handler",
            ".esri-cookie-banner__button",
            "button[aria-label*='Accept' i]",
            "button[title*='Accept' i]"
        ];
        for (var i = 0; i < selectors.length; i++) {
            var btn = document.querySelector(selectors[i]);
            if (btn && btn.offsetParent !== null) {
                try { btn.click(); console.log("[CE] cookies accepted via " + selectors[i]); return true; }
                catch (e) { /* try next */ }
            }
        }
        // Fallback: text-based match
        var buttons = document.querySelectorAll("button, a");
        for (var j = 0; j < buttons.length; j++) {
            var t = (buttons[j].textContent || "").trim().toLowerCase();
            if (t === "accept all cookies" || t === "accept all" || t === "i accept" || t === "accept") {
                try { buttons[j].click(); console.log("[CE] cookies accepted via text match"); return true; }
                catch (e) { /* keep going */ }
            }
        }
        return false;
    }

    // Try once now, then poll for up to ~10s in case the banner appears late.
    clickCookieBanners();
    var cookieTries = 0;
    var cookiePoll = setInterval(function () {
        if (clickCookieBanners() || ++cookieTries > 20) clearInterval(cookiePoll);
    }, 500);

    // ===== 2) Find the ArcGIS MapView via React fibers on .esri-view =====
    function getReactInstance(el) {
        if (!el) return null;
        var key = Object.keys(el).find(function (k) {
            return k.indexOf("__reactFiber") === 0 || k.indexOf("__reactInternalInstance") === 0;
        });
        return key ? el[key] : null;
    }

    function looksLikeMapView(v) {
        return v && v.declaredClass && /MapView/.test(v.declaredClass)
               && v.map && typeof v.goTo === "function";
    }

    function findMapView() {
        // The Wayback app shows its map with the <arcgis-map> component of the Maps SDK (seen in 2026-10), whose
        // "view" is the MapView. The searches below are for the older builds, which had no such element.
        var mapElement = document.querySelector("arcgis-map");
        if (mapElement && looksLikeMapView(mapElement.view)) return mapElement.view;

        // Try a quick well-known global first.
        if (window.view && looksLikeMapView(window.view)) return window.view;

        // Walk React fibers from any .esri-view container.
        var hosts = document.querySelectorAll(".esri-view, .esri-view-root");
        for (var i = 0; i < hosts.length; i++) {
            var fiber = getReactInstance(hosts[i]);
            // Walk up & sideways through stateNode / memoizedProps / return chain.
            var seen = new Set();
            var stack = [fiber];
            var hops = 0;
            while (stack.length && hops++ < 500) {
                var node = stack.pop();
                if (!node || seen.has(node)) continue;
                seen.add(node);
                var candidates = [node.stateNode, node.memoizedState, node.memoizedProps];
                for (var c = 0; c < candidates.length; c++) {
                    var cand = candidates[c];
                    if (looksLikeMapView(cand)) return cand;
                    if (cand && typeof cand === "object") {
                        for (var k in cand) {
                            try { if (looksLikeMapView(cand[k])) return cand[k]; } catch (e) {}
                        }
                    }
                }
                if (node.return) stack.push(node.return);
                if (node.child) stack.push(node.child);
                if (node.sibling) stack.push(node.sibling);
            }
        }

        // Last resort: scan window for any MapView-shaped object.
        for (var prop in window) {
            try { if (looksLikeMapView(window[prop])) return window[prop]; } catch (e) {}
        }
        return null;
    }

    // ===== 3) Draw the plot as graphics of the map =====
    // The Wayback bundle exposes no require(), so there is no Graphic class to call; the view's graphics collection
    // makes Graphics of plain objects itself (autocast). A graphic is in map coordinates: the view projects the WGS84
    // rings to its own spatial reference and keeps them on the ground through every pan, zoom and resize, with nothing
    // to watch. Seen working on the live page in 2026-10 (Maps SDK, Web Mercator view).
    var OUTLINE_SYMBOL = { type: "simple-fill", color: [0, 0, 0, 0], outline: { color: [255, 255, 0, 1], width: 2 } };

    function isOurs(graphic) {
        return graphic && graphic.attributes && graphic.attributes[PLOT_TAG] === true;
    }

    function removeGraphics(view) {
        try {
            var ours = view.graphics.toArray().filter(isOurs);
            if (ours.length) view.graphics.removeMany(ours);
        } catch (e) { console.warn("[CE] could not remove the plot drawn before", e); }
    }

    /** Whether the plot could be drawn as graphics; if not, nothing of it is left on the map. */
    function drawGraphics(view) {
        if (!view.graphics || typeof view.graphics.addMany !== "function") return false;
        removeGraphics(view);
        var graphics = [];
        rings.forEach(function (ring) {
            if (!ring || ring.length < 3) return;
            var attributes = {};
            attributes[PLOT_TAG] = true;
            graphics.push({ geometry: { type: "polygon", rings: [ring], spatialReference: { wkid: 4326 } },
                symbol: OUTLINE_SYMBOL, attributes: attributes });
        });
        try {
            view.graphics.addMany(graphics);
        } catch (e) {
            console.warn("[CE] the map did not take the plot as graphics", e);
            removeGraphics(view);
            return false;
        }
        // Made Graphics of: a build that does not autocast keeps the plain objects, which draw nothing
        var added = view.graphics.toArray().filter(isOurs);
        var ok = added.length === graphics.length && added.every(function (g) {
            return g.geometry && /Polygon/.test(g.geometry.declaredClass || "");
        });
        if (!ok) {
            console.warn("[CE] the map did not make graphics of the plot; drawing it over the map instead");
            removeGraphics(view);
        }
        return ok;
    }

    // ===== 4) Else draw the plot as an SVG overlay positioned via view.toScreen() =====
    // Re-projected on every extent/size change so it stays glued to the map.
    var WEB_MERCATOR_WKIDS = [102100, 102113, 3857, 900913];
    var EARTH_RADIUS = 6378137;
    var MAX_MERCATOR_LATITUDE = 85.05112878;

    /**
     * The point in the view's own coordinates: toScreen() does not project, so a WGS84 point on a Web Mercator view
     * would land near 0,0. Null when the view is in another spatial reference.
     */
    function makePointFactory(view) {
        var sr = view.spatialReference || {};
        var webMercator = sr.isWebMercator || WEB_MERCATOR_WKIDS.indexOf(sr.wkid) >= 0;
        var wgs84 = sr.isWGS84 || sr.wkid === 4326;
        if (!webMercator && !wgs84) {
            console.warn("[CE] the map is in spatial reference " + sr.wkid + ", the plot cannot be placed on it");
            return null;
        }
        return function (lon, lat) {
            var x = lon, y = lat;
            if (webMercator) {
                // Web Mercator ends at about 85.05 degrees: beyond, y grows to infinity at the pole
                var mercatorLat = Math.max(-MAX_MERCATOR_LATITUDE, Math.min(MAX_MERCATOR_LATITUDE, lat));
                x = EARTH_RADIUS * lon * Math.PI / 180;
                y = EARTH_RADIUS * Math.log(Math.tan(Math.PI / 4 + mercatorLat * Math.PI / 360));
            }
            // A Point of the view's own class when it can be had: toScreen() of some builds wants one
            if (view.center && typeof view.center.clone === "function") {
                var p = view.center.clone();
                p.x = x;
                p.y = y;
                return p;
            }
            return { type: "point", x: x, y: y, spatialReference: view.spatialReference };
        };
    }

    function ensureOverlay(view) {
        var host = view.container;
        if (!host) return null;
        // Make sure the host is a positioning context.
        var hostStyle = window.getComputedStyle(host);
        if (hostStyle.position === "static") host.style.position = "relative";

        var existing = host.querySelector("svg[data-ce-overlay='" + PLOT_TAG + "']");
        if (existing) existing.parentNode.removeChild(existing);

        var svgNS = "http://www.w3.org/2000/svg";
        var svg = document.createElementNS(svgNS, "svg");
        svg.setAttribute("data-ce-overlay", PLOT_TAG);
        svg.style.position = "absolute";
        svg.style.top = "0";
        svg.style.left = "0";
        svg.style.width = "100%";
        svg.style.height = "100%";
        svg.style.pointerEvents = "none";
        svg.style.zIndex = "5";
        host.appendChild(svg);
        return svg;
    }

    function drawPlot(view) {
        if (stopped) return; // a later injection took over while the map got ready
        // The SVG overlay of an earlier injection, which drew it that way
        var old = view.container && view.container.querySelector("svg[data-ce-overlay='" + PLOT_TAG + "']");
        if (old) old.parentNode.removeChild(old);
        if (drawGraphics(view)) {
            drawnOn = view;
            centerOnPlot(view);
            console.log("[CE] plot drawn on ESRI Wayback as graphics (" + rings.length + " ring(s))");
            return;
        }
        drawOverlay(view);
        centerOnPlot(view);
    }

    // The scale of Google Earth Web's view of the plot: this much ground from the top to the bottom of the map
    var VIEW_HEIGHT_METERS = ${viewHeightMeters};

    // The zoom showing VIEW_HEIGHT_METERS over the height of the map: Web Mercator has 156543.03 m per pixel at zoom
    // 0 on the equator, cos(latitude) times that on the ground elsewhere, half as many at each zoom level
    function plotZoom(view) {
        var height = view.height > 0 ? view.height : 800;
        var zoom = Math.log2(156543.03392804097 * Math.cos(plotCenter[1] * Math.PI / 180) * height / VIEW_HEIGHT_METERS);
        return isFinite(zoom) ? zoom : 18;
    }

    var sizeWatched = false;

    function centerOnPlot(view) {
        try {
            // Not rounded to a whole zoom level, which could show twice or half the ground of Google Earth Web
            if (view.constraints) view.constraints.snapToZoom = false;
            var zoom = plotZoom(view);
            view.goTo({ target: [plotCenter[0], plotCenter[1]], zoom: zoom }, { animate: false });
            if (!sizeWatched && typeof view.watch === "function") {
                // A tab opened behind another has a small window until it is shown: zoomed again once the map has its
                // size, unless the user zoomed meanwhile
                sizeWatched = true;
                watchHandles.push(view.watch("size", function () {
                    if (stopped || Math.abs(view.zoom - zoom) > 0.01) return;
                    zoom = plotZoom(view);
                    view.goTo({ target: [plotCenter[0], plotCenter[1]], zoom: zoom }, { animate: false });
                }));
            }
        } catch (e) { /* ignore */ }
    }

    function drawOverlay(view) {
        var toPoint = makePointFactory(view);
        if (!toPoint) return;
        var svg = ensureOverlay(view);
        if (!svg) {
            console.warn("[CE] no view.container to attach overlay to");
            return;
        }
        var svgNS = "http://www.w3.org/2000/svg";

        function redraw() {
            // Clear children
            while (svg.firstChild) svg.removeChild(svg.firstChild);

            rings.forEach(function (ring) {
                if (!ring || ring.length < 3) return;
                var pts = [];
                for (var i = 0; i < ring.length; i++) {
                    var sp;
                    try { sp = view.toScreen(toPoint(ring[i][0], ring[i][1])); }
                    catch (e) { sp = null; }
                    if (sp) pts.push(sp.x.toFixed(1) + "," + sp.y.toFixed(1));
                }
                if (pts.length < 3) return;
                var poly = document.createElementNS(svgNS, "polygon");
                poly.setAttribute("points", pts.join(" "));
                poly.setAttribute("fill", "none");
                poly.setAttribute("stroke", "#FFFF00");
                poly.setAttribute("stroke-width", "2");
                poly.setAttribute("vector-effect", "non-scaling-stroke");
                svg.appendChild(poly);
            });
        }

        // Initial draw, then keep in sync with pan/zoom/resize.
        redraw();
        var watched = 0;
        ["extent", "size", "rotation"].forEach(function (property) {
            try {
                watchHandles.push(view.watch(property, redraw));
                watched++;
            } catch (e) {
                console.warn("[CE] cannot watch the map's " + property + "; the plot is redrawn by polling instead", e);
            }
        });
        if (watched < 3) {
            // A build without watch(): the outline would stay where it was first drawn as the map moves
            var last = "";
            extentPoll = setInterval(function () {
                var e = view.extent;
                var now = e ? [e.xmin, e.ymin, e.xmax, e.ymax, view.width, view.height, view.rotation].join(",") : "";
                if (now !== last) {
                    last = now;
                    redraw();
                }
            }, 250);
        }

        console.log("[CE] plot drawn on ESRI Wayback over the map (" + rings.length + " ring(s))");
    }

    // Wait for the MapView to be present and ready before drawing.
    var attempts = 0;
    var maxAttempts = 60; // ~30s
    var poll = setInterval(function () {
        var view = findMapView();
        if (view) {
            clearInterval(poll);
            if (view.ready) {
                drawPlot(view);
            } else {
                view.when(function () { drawPlot(view); },
                          function (err) { console.warn("[CE] view.when error", err); });
            }
        } else if (++attempts > maxAttempts) {
            clearInterval(poll);
            console.warn("[CE] Could not locate the ArcGIS MapView on this page");
        }
    }, 500);
})();
