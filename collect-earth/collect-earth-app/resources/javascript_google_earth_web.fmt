// Runs as the body of a function (ImageryTab.evaluate): says "armed", or "no_body" when it could not draw yet
return (function () {
    // ===== Plot geometry from Collect Earth (lon, lat pairs in WGS84) =====
    // Outer rings = the plot polygon and any buffers (placemark.multiShape).
    // Sample rings = the sample squares (placemark.points[].shape).
    var plotRings = [
        <#if placemark.multiShape??>
        <#list placemark.multiShape as shp>
        [
            <#list shp as coord>
            [${coord.longitude}, ${coord.latitude}]<#if coord?has_next>,</#if>
            </#list>
        ]<#if shp?has_next>,</#if>
        </#list>
        </#if>
    ];
    var sampleRings = [
        <#if placemark.points??>
            <#list placemark.points as square>
            [
                <#list square.shape as sc>
                [${sc.longitude}, ${sc.latitude}]<#if sc?has_next>,</#if>
                </#list>
            ]<#if square?has_next>,</#if>
            </#list>
        </#if>
    ];
    // Neighbouring plots from the plots map: [{id, status: empty|partial|saved, rings: [[[lon, lat], ...]]}]
    // (rebuilt from typed values by Collect Earth, see PlacemarkBrowserServlet.googleEarthWebContext)
    var neighbours = ${neighboursJson!"[]"};
    var STATUS_COLORS = { empty: "#e53935", partial: "#fdd835", saved: "#43a047" };
    var PLOT_ID = "${plotId?js_string}";
    // Top-down view of the plot, used by the "Top-down view" button
    var PLOT_URL = "${plotUrl?js_string}";
    // Whether Google Earth Web follows in-page navigation: "true", "false" or "null" (not tried yet)
    var IN_PAGE_NAVIGATION = "${inPageNavigation}";
    // Camera URL Collect Earth has just sent Google Earth Web flying to, "" if none (see expectFlight)
    var FLIGHT_URL = "${(flightUrl!"")?js_string}";
    var CE_TAG = "__collectEarthGewOverlay";
    // Texts in the Collect Earth UI language
    var LABELS = {
        <#list labels as key, text>
        "${key}": "${text?js_string}"<#sep>,</#sep>
        </#list>
    };

    // A document still being built has no body to draw in: Google Earth Web redirects on its way to the app
    // (/web/@... to /static/.../index.html#@...), and a script can land in the new document before its body is
    // there. Nothing is drawn, and Collect Earth tries again (GoogleEarthWebService.injectOverlay).
    if (!document.body) return "no_body";

    // ===== Cleanup from any previous injection (driver reuses the tab) =====
    // A redraw with new neighbours during a flight keeps waiting for the camera to arrive
    var inheritedFlight = window[CE_TAG] && window[CE_TAG].flight ? window[CE_TAG].flight() : null;
    // and so does one during a move of the user
    var inheritedMove = window[CE_TAG] && window[CE_TAG].moving ? window[CE_TAG].moving() : null;
    if (window[CE_TAG] && window[CE_TAG].stop) {
        try { window[CE_TAG].stop(); } catch (e) { /* ignore */ }
    }

    // ===== Camera state from the GEW URL =====
    // Format: https://earth.google.com/web/@LAT,LON,ALTa,DISTd,FOVy,HEADINGh,TILTt,ROLLr
    // GEW keeps this up to date as the camera settles; there is no public API,
    // so the URL is the only reliable camera source. All maths below assume a
    // (near-)nadir view, which Collect Earth enforces by flying with 0h,0t,0r.
    function parseCamera(href) {
        var m = (href || window.location.href).match(
            /@(-?[0-9.]+),(-?[0-9.]+),(-?[0-9.]+)a,(-?[0-9.]+)d,(-?[0-9.]+)y,(-?[0-9.]+)h,(-?[0-9.]+)t,(-?[0-9.]+)r/);
        if (!m) return null;
        return {
            lat: parseFloat(m[1]), lon: parseFloat(m[2]), alt: parseFloat(m[3]),
            dist: parseFloat(m[4]), distText: m[4], fov: parseFloat(m[5]),
            heading: parseFloat(m[6]), tilt: parseFloat(m[7])
        };
    }

    var svgNS = "http://www.w3.org/2000/svg";

    // ===== Full-viewport SVG overlay (attached to body, ignores GEW's DOM) =====
    function ensureOverlay() {
        var existing = document.querySelector("svg[data-ce-overlay]");
        if (existing) existing.parentNode.removeChild(existing);
        var el = document.createElementNS(svgNS, "svg");
        el.setAttribute("data-ce-overlay", "1");
        el.style.cssText = "position:fixed;top:0;left:0;width:100vw;height:100vh;pointer-events:none;"
            + "z-index:2147483000;display:none";
        document.body.appendChild(el);
        return el;
    }
    var svg = ensureOverlay();

    // ===== Information bar: which plot this is, and why the outline is hidden =====
    // Built with DOM APIs only (the plot id comes from the survey CSV).
    function ensureInfoBar() {
        var existing = document.querySelector("div[data-ce-infobar]");
        if (existing) existing.parentNode.removeChild(existing);
        var bar = document.createElement("div");
        bar.setAttribute("data-ce-infobar", "1");
        bar.style.cssText = "position:fixed;top:12px;left:50%;transform:translateX(-50%);z-index:2147483001;"
            + "display:flex;align-items:center;gap:10px;padding:6px 8px 6px 14px;border-radius:18px;"
            + "background:rgba(32,33,36,.92);color:#fff;font:500 13px/1.3 Roboto,Arial,sans-serif;"
            + "box-shadow:0 2px 8px rgba(0,0,0,.4);white-space:nowrap;pointer-events:auto";
        var title = document.createElement("span");
        title.setAttribute("data-ce-title", "1");
        title.style.fontWeight = "700";
        title.textContent = PLOT_ID ? "Collect Earth \u00b7 " + LABELS.plot + " " + PLOT_ID : "Collect Earth";
        var hint = document.createElement("span");
        hint.setAttribute("data-ce-hint", "1");
        hint.style.cssText = "color:#ffe082;display:none";
        var button = document.createElement("button");
        button.setAttribute("data-ce-topdown", "1");
        button.textContent = LABELS.topDown;
        button.title = LABELS.topDownTooltip;
        button.style.cssText = "border:0;border-radius:14px;padding:5px 12px;cursor:pointer;display:none;"
            + "background:#8ab4f8;color:#202124;font:600 12px Roboto,Arial,sans-serif";
        button.onclick = flyToPlot;
        bar.appendChild(title);
        bar.appendChild(hint);
        bar.appendChild(button);
        document.body.appendChild(bar);
        return { bar: bar, hint: hint, button: button };
    }
    var info = ensureInfoBar();

    function setHint(text, showButton) {
        info.hint.textContent = text || "";
        info.hint.style.display = text ? "inline" : "none";
        info.button.style.display = showButton ? "inline-block" : "none";
    }

    // Back to the top-down plot view. In-page when GEW follows it (no reload); otherwise a
    // page load - Collect Earth then re-draws the outline within a few seconds.
    function flyToPlot() {
        if (IN_PAGE_NAVIGATION === "true") {
            history.pushState(null, "", PLOT_URL);
            window.dispatchEvent(new PopStateEvent("popstate", { state: null }));
            expectFlight(PLOT_URL);
        } else {
            window.location.assign(PLOT_URL);
        }
    }

    // ===== Project lon/lat -> screen pixels from the nadir camera =====
    // Ground meters per screen pixel from camera distance and vertical FOV,
    // then a local flat-earth offset from the camera target (fine at plot
    // scale, a few hundred metres). Heading rotates the offsets; tilt makes
    // the projection invalid, so the overlay hides when tilted.
    function project(cam, lon, lat) {
        var rad = Math.PI / 180;
        var mPerDegLat = 111320;
        var mPerDegLon = 111320 * Math.cos(cam.lat * rad);
        // Across the antimeridian the shorter way round: 179.999 seen from -179.999 is 0.002 degrees east, not 360 west
        var e = (((lon - cam.lon + 540) % 360) - 180) * mPerDegLon;
        var n = (lat - cam.lat) * mPerDegLat;
        var h = cam.heading * rad;
        var x = e * Math.cos(h) - n * Math.sin(h);
        var yUp = n * Math.cos(h) + e * Math.sin(h);
        var mpp = 2 * cam.dist * Math.tan((cam.fov * rad) / 2) / window.innerHeight;
        return {
            x: window.innerWidth / 2 + x / mpp,
            y: window.innerHeight / 2 - yUp / mpp
        };
    }

    function hide(reason, showButton) {
        svg.style.display = "none";
        setHint(reason, showButton);
    }

    // A dark halo under each line keeps it readable on bright imagery (sand, clouds, roofs).
    function addRing(cam, ring, color, width, kind) {
        if (!ring || ring.length < 3) return false;
        var pts = [];
        for (var i = 0; i < ring.length; i++) {
            var sp = project(cam, ring[i][0], ring[i][1]);
            pts.push(sp.x.toFixed(1) + "," + sp.y.toFixed(1));
        }
        [["rgba(0,0,0,.55)", width + 2], [color, width]].forEach(function (style) {
            var poly = document.createElementNS(svgNS, "polygon");
            poly.setAttribute("points", pts.join(" "));
            poly.setAttribute("fill", "none");
            poly.setAttribute("stroke", style[0]);
            poly.setAttribute("stroke-width", String(style[1]));
            poly.setAttribute("stroke-linejoin", "round");
            poly.setAttribute("data-ce-ring", kind);
            svg.appendChild(poly);
        });
        return true;
    }

    function draw() {
        var cam = parseCamera();
        if (!cam) { hide(LABELS.hintUnavailable, true); return; }
        if (Math.abs(cam.tilt) > 5) { hide(LABELS.hintTilted, true); return; }
        while (svg.firstChild) svg.removeChild(svg.firstChild);
        var drawn = 0;
        // Neighbours first (underneath), in their status colours, so the grid reads like the map
        neighbours.forEach(function (n) {
            if (n.id === PLOT_ID) return;
            n.rings.forEach(function (ring) { addRing(cam, ring, STATUS_COLORS[n.status] || STATUS_COLORS.empty, 2, "neighbour"); });
        });
        // Current plot in the plots map's selection cyan: yellow already means "in progress"
        plotRings.forEach(function (ring) { if (addRing(cam, ring, "#00e5ff", 3, "plot")) drawn++; });
        sampleRings.forEach(function (ring) { if (addRing(cam, ring, "#ffffff", 1.5, "sample")) drawn++; });
        svg.style.display = drawn > 0 ? "block" : "none";
        // A far-away camera (user zoomed/panned out) is not an error; offer the way back.
        var c = project(cam, plotRings.length && plotRings[0].length ? plotRings[0][0][0] : cam.lon,
            plotRings.length && plotRings[0].length ? plotRings[0][0][1] : cam.lat);
        var offScreen = c.x < 0 || c.y < 0 || c.x > window.innerWidth || c.y > window.innerHeight;
        setHint(offScreen ? LABELS.hintOutOfView : "", offScreen);
    }

    // ===== Hidden while Google Earth Web flies to a camera Collect Earth sent =====
    // During an in-page flight the URL keeps the camera that was pushed (GEW only appends its
    // /data= suffix at once) for the ~4 s of the animation, then GEW writes the camera it arrived
    // at (e.g. 400d becomes 400.00468618d). A URL that does not change would otherwise count as
    // settled, and the plot would be drawn over the imagery still moving under it.
    var FLIGHT_TIMEOUT_MILLIS = 8000;
    var flight = null;
    // the user grabbed the camera during the flight: then it has to settle like any user move
    var userMoved = false;

    // GEW may reformat the numbers it was given (-16.322392999999998 -> -16.322393), but it keeps the
    // distance as written until the camera arrives, then writes the one it computed (400 -> 400.00453096)
    function sameCamera(a, b) {
        return a.distText === b.distText && Math.abs(a.lat - b.lat) < 1e-5 && Math.abs(a.lon - b.lon) < 1e-5
            && a.heading === b.heading && a.tilt === b.tilt;
    }

    function expectFlight(url) {
        var cam = parseCamera(url);
        flight = cam ? { cam: cam, until: Date.now() + FLIGHT_TIMEOUT_MILLIS } : null;
        userMoved = false;
        hide("", false);
        stableCount = 0;
    }

    // Over once GEW writes a camera of its own (arrived, or the user took over), or after the timeout
    function inFlight() {
        if (!flight) return false;
        var cam = parseCamera();
        if (cam && sameCamera(cam, flight.cam) && Date.now() <= flight.until) return true;
        var arrived = cam && Date.now() <= flight.until && !userMoved;
        flight = null;
        if (arrived) {
            // GEW writes the camera once it is at rest: no need to wait for it to stay the same
            lastHref = window.location.href;
            stableCount = STABLE_READS;
            draw();
            return true;
        }
        return false;
    }

    // ===== Hidden while the user moves the camera =====
    // The same holds for a zoom with the wheel, a drag or the keyboard: GEW writes the new camera
    // only once it comes to rest, about a second later, and until then the URL still has the old
    // one. Waiting for it to stay the same drew the outline where the camera had been, over imagery
    // still moving, and hid it again as soon as the new camera was written.
    var MOVE_TIMEOUT_MILLIS = 3000;
    var moving = null;

    function startMoving() {
        moving = { from: window.location.href, until: Date.now() + MOVE_TIMEOUT_MILLIS };
        if (flight) userMoved = true;
        hide("", false);
        stableCount = 0;
    }

    // Over once GEW writes the camera the move ended at; a move that did not change it (a zoom past
    // the limit) falls back to waiting for the URL to stay the same
    function inUserMove() {
        if (!moving) return false;
        // A drag held still: GEW may write the camera only once it is released, which starts the timeout
        if (pressed) return true;
        var href = window.location.href;
        if (href === moving.from && Date.now() <= moving.until) return true;
        moving = null;
        if (href !== lastHref) {
            lastHref = href;
            stableCount = STABLE_READS;
            draw();
            return true;
        }
        return false;
    }

    // ===== Redraw when the camera settles, hide while it moves =====
    // Otherwise poll the URL and draw after it has stayed the same for STABLE_READS reads.
    // Any interaction hides the overlay immediately so a stale projection is never shown
    // over moving imagery.
    var POLL_MILLIS = 200;
    var STABLE_READS = 4;
    var lastHref = null;
    var stableCount = 0;
    if (FLIGHT_URL) expectFlight(FLIGHT_URL);
    else if (inheritedFlight) flight = inheritedFlight;
    if (inheritedMove) moving = inheritedMove;
    var timer = setInterval(function () {
        if (inFlight() || inUserMove()) return;
        var href = window.location.href;
        if (href !== lastHref) {
            lastHref = href;
            stableCount = 0;
            hide("", false);
            return;
        }
        stableCount++;
        if (stableCount === STABLE_READS) draw();
    }, POLL_MILLIS);

    // Only a node can be on the bar: the target of a resize is the window, which contains() does not take
    function onBar(e) {
        return !!e && e.target instanceof Node && info.bar.contains(e.target);
    }

    // A press alone may be a click that moves nothing: it hides the outline until the URL is stable
    // again, and turns into a move once the pointer drags
    var pressed = false;
    function onPress(e) {
        if (onBar(e)) return;
        pressed = true;
        if (flight) userMoved = true;
        hide("", false);
        stableCount = 0;
    }
    function onDrag(e) {
        // Released outside the window, where no mouseup came: the move ends as with one
        if (pressed && !e.buttons) { onRelease(); return; }
        if (pressed && e.buttons && !moving) startMoving();
    }
    function onRelease() {
        pressed = false;
        if (moving) moving.until = Date.now() + MOVE_TIMEOUT_MILLIS;
    }
    // The page losing the mouse mid-drag (the window minimized and restored, another one brought forward, the tab
    // hidden) sends no mouseup: the press ends there, or the outline would stay hidden until the mouse came back.
    // Only the window's own blur: an element's, captured here too, comes with the press that moves the focus
    function onFocusLost(e) {
        if (!pressed) return;
        if (e.type === "blur" && e.target !== window) return;
        if (e.type === "visibilitychange" && !document.hidden) return;
        onRelease();
    }
    function onMove(e) {
        if (onBar(e)) return;
        startMoving();
    }
    // A window resized keeps its camera, but the outline is projected for the old size: drawn again once the size
    // and the URL have stayed the same for STABLE_READS reads
    function onResize() {
        hide("", false);
        stableCount = 0;
    }
    // the keyboard moves the camera too (arrows, Page Up/Down, +/-), except while typing in GEW's search box
    function onKey(e) {
        // Tab or Enter on the bar's own button moves nothing (Enter on it flies, which hides the outline by itself)
        if (onBar(e)) return;
        var t = e.target;
        if (e.ctrlKey || e.metaKey || e.altKey) return;
        if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
        startMoving();
    }
    var LISTENERS = [["mousedown", onPress], ["mousemove", onDrag], ["mouseup", onRelease], ["wheel", onMove],
        ["touchstart", onMove], ["keydown", onKey], ["resize", onResize],
        ["blur", onFocusLost], ["pointercancel", onFocusLost], ["visibilitychange", onFocusLost]];
    LISTENERS.forEach(function (l) { window.addEventListener(l[0], l[1], true); });

    window[CE_TAG] = {
        plotId: PLOT_ID,
        // the plots map moved the camera (GoogleEarthWebService.CAMERA_MOVE_SCRIPT)
        expectFlight: expectFlight,
        flight: function () { return inFlight() ? flight : null; },
        moving: function () { return moving; },
        stop: function () {
            clearInterval(timer);
            LISTENERS.forEach(function (l) { window.removeEventListener(l[0], l[1], true); });
            if (svg && svg.parentNode) svg.parentNode.removeChild(svg);
            if (info.bar.parentNode) info.bar.parentNode.removeChild(info.bar);
            delete window[CE_TAG];
        }
    };
    console.log("[CE] Google Earth Web plot overlay armed for plot " + PLOT_ID
        + " (" + plotRings.length + " plot ring(s), " + sampleRings.length + " sample(s))");
    return "armed";
})();
