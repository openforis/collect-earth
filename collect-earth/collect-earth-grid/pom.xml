<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.openforis.collect.earth</groupId>
		<artifactId>collect-earth</artifactId>
		<version>1.23.14-SNAPSHOT</version>
	</parent>

	<artifactId>collect-earth-grid</artifactId>
	<packaging>jar</packaging>
	<name>Open Foris Collect Earth Grid</name>
	<description>Module to create Collect Earth Global Grids</description>

	<properties>
		<!-- This module has never been published: no collect-earth-grid artifact
		     exists in any repository. Now that it is in the reactor it would be
		     deployed along with everything else, and a first publication to Maven
		     Central cannot be withdrawn. It is a grid-generation tool rather than
		     part of the shipped application, so deployment stays off. Remove this
		     property if it should be published. -->
		<maven.deploy.skip>true</maven.deploy.skip>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.openforis.collect.earth</groupId>
			<artifactId>collect-earth-sampler</artifactId>
		</dependency>
		<dependency>
			<groupId>org.hibernate</groupId>
			<artifactId>hibernate-core</artifactId>
			<version>5.4.24.Final</version>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<version>42.5.1</version>
		</dependency>
		<dependency>
			<groupId>org.xerial</groupId>
			<artifactId>sqlite-jdbc</artifactId>
			<version>3.36.0.3</version>
			<!-- This latest version provokes an exception in Linux! <version>3.8.7</version> -->
		</dependency>
	</dependencies>
</project>