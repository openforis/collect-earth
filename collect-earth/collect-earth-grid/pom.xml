<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.openforis.collect.earth</groupId>
		<artifactId>collect-earth</artifactId>
		<version>1.23.16-SNAPSHOT</version>
	</parent>

	<artifactId>collect-earth-grid</artifactId>
	<packaging>jar</packaging>
	<name>Open Foris Collect Earth Grid</name>
	<description>Module to create Collect Earth Global Grids</description>

	<properties>
		<!-- This module has never been published: no collect-earth-grid artifact
		     exists in any repository. Now that it is in the reactor it would be
		     deployed along with everything else, and a first publication to Maven
		     Central cannot be withdrawn. It is a grid-generation tool rather than
		     part of the shipped application, so deployment stays off. Remove both
		     properties if it should be published, and declare maven-source-plugin
		     and maven-javadoc-plugin here as the other three modules do: Central
		     rejects a component that has no sources jar and no javadoc jar.

		     Both properties are needed. maven.deploy.skip only stops
		     maven-deploy-plugin, and the release profile gives
		     nexus-staging-maven-plugin extensions=true, which takes the deploy
		     lifecycle over from it. 1.23.14 was therefore staged with this module
		     in the bundle, and the Central Portal failed the whole deployment on
		     it: "7 out of 8 Components Validated", the eighth being
		     collect-earth-grid with neither jar. -->
		<maven.deploy.skip>true</maven.deploy.skip>
		<skipNexusStagingDeployMojo>true</skipNexusStagingDeployMojo>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.openforis.collect.earth</groupId>
			<artifactId>collect-earth-sampler</artifactId>
		</dependency>
		<dependency>
			<groupId>org.hibernate</groupId>
			<artifactId>hibernate-core</artifactId>
			<!-- GHSA-2p5w-cvg5-gc5c reports a second-order SQL injection for every 5.x, with no fixed 5.x to move to. It
			     needs InlineIdsOrClauseBuilder, which this module cannot reach: HibernateStore only saves Plot entities and
			     every query in the module is written by hand in JDBCStore. Moving to Hibernate 6 for a tool that persists a
			     single entity is the change to make when this module is next touched. -->
			<version>5.4.24.Final</version>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<!-- 42.5.1 carried GHSA-24rp-q3w6-vc56 (SQL injection through a line comment) and GHSA-98qh-xjc8-98pq.
			     The same version the application resolves, so the whole build agrees on one driver. -->
			<version>42.7.13</version>
		</dependency>
		<dependency>
			<groupId>org.xerial</groupId>
			<artifactId>sqlite-jdbc</artifactId>
			<!-- 3.36.0.3 carried GHSA-6phf-6h5g-97j2. The comment that used to sit here warned that "the latest version"
			     threw on Linux; it was about 3.8.7, and the application has been shipping this one for a while. -->
			<version>3.53.4.0</version>
		</dependency>
	</dependencies>
</project>