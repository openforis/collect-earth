{
  "v": 1,
  "layers": {
    "sentinel2": {
      "title": "Sentinel-2 composite",
      "params": {
        "label": { "type": "text", "max": 60 },
        "years": { "type": "yearRange", "min": 2016 },
        "year": { "type": "year", "min": 2016 },
        "start": { "type": "date" },
        "end": { "type": "date" },
        "bands": { "type": "choice", "values": ["false-colour", "true-colour"], "default": "false-colour" },
        "maxCloud": { "type": "int", "min": 1, "max": 100, "default": 70 }
      }
    },
    "landsat": {
      "title": "Landsat yearly composite",
      "params": {
        "label": { "type": "text", "max": 60 },
        "years": { "type": "yearRange", "min": 1984 },
        "year": { "type": "year", "min": 1984 },
        "bands": { "type": "choice", "values": ["false-colour", "true-colour"], "default": "false-colour" },
        "maxCloud": { "type": "int", "min": 1, "max": 100, "default": 50 }
      }
    },
    "sentinel1": {
      "title": "Sentinel-1 radar yearly composite",
      "params": {
        "label": { "type": "text", "max": 60 },
        "years": { "type": "yearRange", "min": 2015 },
        "year": { "type": "year", "min": 2015 },
        "bands": { "type": "choice", "values": ["false-colour", "vv", "vh"], "default": "false-colour" }
      }
    }
  },
  "charts": {
    "ccdc": {
      "title": "CCDC temporal segmentation",
      "params": {
        "band": { "type": "choice", "values": ["NDFI", "NDVI"], "default": "NDFI" },
        "collapsed": { "type": "bool", "default": false }
      }
    },
    "landsat-series": {
      "title": "Landsat index series",
      "params": {
        "index": { "type": "choice", "values": ["NDVI", "EVI", "EVI2", "SAVI", "MSAVI", "GNDVI", "NDMI", "NBR", "NBR2", "NDWI", "MNDWI", "NDSI", "NDBI", "BSI"], "default": "NDVI" },
        "formula": { "type": "formula", "max": 200 },
        "name": { "type": "text", "max": 30 },
        "median": { "type": "bool", "default": false },
        "trend": { "type": "bool", "default": true },
        "change": { "type": "bool", "default": false },
        "unusual": { "type": "bool", "default": false },
        "season": { "type": "bool", "default": false },
        "maxCloud": { "type": "choice", "values": ["any", "80", "60", "40", "20", "10"], "default": "40" },
        "collapsed": { "type": "bool", "default": false }
      }
    },
    "sentinel2-series": {
      "title": "Sentinel-2 index series",
      "params": {
        "index": { "type": "choice", "values": ["NDVI", "EVI", "EVI2", "SAVI", "MSAVI", "GNDVI", "NDMI", "NBR", "NBR2", "NDWI", "MNDWI", "NDSI", "NDBI", "BSI"], "default": "NDVI" },
        "formula": { "type": "formula", "max": 200 },
        "name": { "type": "text", "max": 30 },
        "median": { "type": "bool", "default": false },
        "trend": { "type": "bool", "default": true },
        "change": { "type": "bool", "default": false },
        "unusual": { "type": "bool", "default": false },
        "season": { "type": "bool", "default": false },
        "maxCloud": { "type": "choice", "values": ["any", "80", "60", "40", "20", "10"], "default": "40" },
        "collapsed": { "type": "bool", "default": false }
      }
    },
    "hls-series": {
      "title": "Harmonized Landsat Sentinel-2 index series",
      "params": {
        "index": { "type": "choice", "values": ["NDVI", "EVI", "EVI2", "SAVI", "MSAVI", "GNDVI", "NDMI", "NBR", "NBR2", "NDWI", "MNDWI", "NDSI", "NDBI", "BSI"], "default": "NDVI" },
        "formula": { "type": "formula", "max": 200 },
        "name": { "type": "text", "max": 30 },
        "median": { "type": "bool", "default": false },
        "trend": { "type": "bool", "default": true },
        "change": { "type": "bool", "default": false },
        "unusual": { "type": "bool", "default": false },
        "season": { "type": "bool", "default": false },
        "maxCloud": { "type": "choice", "values": ["any", "80", "60", "40", "20", "10"], "default": "40" },
        "collapsed": { "type": "bool", "default": false }
      }
    },
    "modis": {
      "title": "MODIS 16-day index and burned area",
      "params": {
        "index": { "type": "choice", "values": ["NDVI", "EVI"], "default": "NDVI" },
        "median": { "type": "bool", "default": false },
        "trend": { "type": "bool", "default": true },
        "change": { "type": "bool", "default": false },
        "unusual": { "type": "bool", "default": false },
        "season": { "type": "bool", "default": false },
        "rainfall": { "type": "bool", "default": false },
        "collapsed": { "type": "bool", "default": false }
      }
    },
    "sentinel1-series": {
      "title": "Sentinel-1 radar backscatter series",
      "params": {
        "band": { "type": "choice", "values": ["VH", "VV"], "default": "VH" },
        "median": { "type": "bool", "default": false },
        "trend": { "type": "bool", "default": true },
        "change": { "type": "bool", "default": false },
        "unusual": { "type": "bool", "default": false },
        "season": { "type": "bool", "default": false },
        "collapsed": { "type": "bool", "default": false }
      }
    },
    "precipitation": {
      "title": "Monthly rainfall",
      "params": {
        "median": { "type": "bool", "default": false },
        "trend": { "type": "bool", "default": false },
        "change": { "type": "bool", "default": false },
        "unusual": { "type": "bool", "default": false },
        "season": { "type": "bool", "default": false },
        "collapsed": { "type": "bool", "default": false }
      }
    }
  },
  "indices": {
    "NDVI": "(nir - red) / (nir + red)",
    "EVI": "2.5 * (nir - red) / (nir + 6 * red - 7.5 * blue + 1)",
    "EVI2": "2.5 * (nir - red) / (nir + 2.4 * red + 1)",
    "SAVI": "1.5 * (nir - red) / (nir + red + 0.5)",
    "MSAVI": "(2 * nir + 1 - sqrt(pow(2 * nir + 1, 2) - 8 * (nir - red))) / 2",
    "GNDVI": "(nir - green) / (nir + green)",
    "NDMI": "(nir - swir1) / (nir + swir1)",
    "NBR": "(nir - swir2) / (nir + swir2)",
    "NBR2": "(swir1 - swir2) / (swir1 + swir2)",
    "NDWI": "(green - nir) / (green + nir)",
    "MNDWI": "(green - swir1) / (green + swir1)",
    "NDSI": "(green - swir1) / (green + swir1)",
    "NDBI": "(swir1 - nir) / (swir1 + nir)",
    "BSI": "((swir1 + red) - (nir + blue)) / ((swir1 + red) + (nir + blue))"
  },
  "bands": {
    "landsat-series": ["blue", "green", "red", "nir", "swir1", "swir2"],
    "sentinel2-series": ["blue", "green", "red", "nir", "swir1", "swir2", "rededge1", "rededge2", "rededge3"],
    "hls-series": ["blue", "green", "red", "nir", "swir1", "swir2"]
  },
  "standard": {
    "v": 1,
    "layers": [{ "type": "sentinel2" }, { "type": "landsat" }, { "type": "sentinel1" }],
    "charts": [{ "type": "landsat-series" }, { "type": "sentinel2-series" }, { "type": "ccdc" }, { "type": "modis" }, { "type": "sentinel1-series", "collapsed": true }, { "type": "precipitation", "collapsed": true }]
  },
  "presets": {
    "deforestation": {
      "v": 1,
      "layers": [{ "type": "sentinel2" }, { "type": "landsat" }],
      "charts": [{ "type": "ccdc" }, { "type": "landsat-series", "change": true }, { "type": "sentinel2-series", "change": true }, { "type": "modis", "collapsed": true }]
    },
    "fire": {
      "v": 1,
      "layers": [{ "type": "sentinel2" }, { "type": "landsat" }],
      "charts": [{ "type": "landsat-series", "index": "NBR", "change": true, "unusual": true }, { "type": "modis" }, { "type": "sentinel2-series", "index": "NBR", "change": true }, { "type": "ccdc", "collapsed": true }]
    },
    "cloudy": {
      "v": 1,
      "layers": [{ "type": "sentinel1" }, { "type": "sentinel2" }, { "type": "landsat" }],
      "charts": [{ "type": "sentinel1-series" }, { "type": "landsat-series" }, { "type": "ccdc" }, { "type": "sentinel2-series", "collapsed": true }, { "type": "modis", "collapsed": true }]
    },
    "drylands": {
      "v": 1,
      "layers": [{ "type": "sentinel2" }, { "type": "landsat" }],
      "charts": [{ "type": "modis", "rainfall": true, "season": true }, { "type": "precipitation" }, { "type": "landsat-series", "index": "SAVI" }, { "type": "sentinel2-series", "index": "SAVI", "collapsed": true }]
    }
  }
}
