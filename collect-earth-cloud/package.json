{
  "name": "collect-earth-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud sync + coordination backend for Collect Earth (Phase 0: minimal viable record sync).",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build:local": "node scripts/build-local.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/store/migrate.ts",
    "smoke:pg": "tsx scripts/pg-smoke-activity.mts",
    "smoke:pg:progress": "tsx scripts/pg-smoke-progress.mts",
    "smoke:pg:activity": "tsx scripts/pg-smoke-activity-log.mts",
    "smoke:pg:panel": "tsx scripts/pg-smoke-server-panel.mts",
    "smoke:pg:accounts": "tsx scripts/pg-smoke-accounts.mts",
    "smoke:pg:sampling": "tsx scripts/pg-smoke-sampling.mts",
    "smoke:pg:batch": "tsx scripts/pg-smoke-batch.mts",
    "load:mapathon": "tsx scripts/load-mapathon.mts",
    "smoke:pg:reference": "tsx scripts/pg-smoke-reference.mts",
    "smoke:pg:training-team": "tsx scripts/pg-smoke-training-team.mts",
    "smoke:pg:backup": "tsx scripts/pg-smoke-backup.mts",
    "smoke:pg:links": "tsx scripts/pg-smoke-share-links.mts",
    "smoke:pg:mail": "tsx scripts/pg-smoke-mail.mts",
    "smoke:pg:final": "tsx scripts/pg-smoke-final-review.mts",
    "smoke:pg:repeat": "tsx scripts/pg-smoke-repeat.mts",
    "smoke:pg:security": "tsx scripts/pg-smoke-security-review.mts",
    "smoke:pg:ceo": "tsx scripts/pg-smoke-ceo-import.mts",
    "telemetry:check": "tsx scripts/telemetry-check.mts",
    "smoke:pg:ops": "tsx scripts/pg-smoke-ops.mts",
    "smoke:pg:safety": "tsx scripts/pg-smoke-safety.mts",
    "smoke:pg:give": "tsx scripts/pg-smoke-give.mts",
    "smoke:pg:invite-plots": "tsx scripts/pg-smoke-invite-plots.mts"
  },
  "dependencies": {
    "@fastify/proxy-addr": "^5.1.3",
    "@fastify/static": "^10.1.11",
    "@google/genai": "2.30.0",
    "@sentry/node": "10.78.0",
    "fast-xml-parser": "5.12.0",
    "fastify": "^5.12.8",
    "fflate": "0.8.3",
    "nodemailer": "10.1.7",
    "pg": "^8.12.0",
    "pg-connection-string": "2.14.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.11.6",
    "esbuild": "0.28.1",
    "typescript": "^5.5.4",
    "vitest": "^5.1.0"
  }
}
