# Collect Earth Cloud — environment configuration (copy to .env for local runs)

# Network
PORT=8080
HOST=0.0.0.0

# Storage backend: "memory" (dev/tests, no persistence) or "postgres"
STORE_BACKEND=memory

# Required when STORE_BACKEND=postgres
DATABASE_URL=postgres://ce:ce@localhost:5432/collect_earth_cloud

# Guards project provisioning (POST /v1/projects). If unset, provisioning is OPEN
# (fine for local dev only). In the hosted model the platform operator sets this.
ADMIN_API_KEY=

# Public HTTPS base URL of this server. Used to build /join/<token> links the
# desktop client opens. Set this in production, e.g. https://ce-cloud.example.org
PUBLIC_BASE_URL=

# When "true", apply pending SQL migrations on boot before listening (requires
# STORE_BACKEND=postgres). Convenient for single-instance deploys; for multi-
# instance rollouts run `npm run migrate` as a one-off release step instead.
MIGRATE_ON_BOOT=false
