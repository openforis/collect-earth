# Collect Earth Cloud — environment configuration (copy to .env for local runs)

# Network
PORT=8080
HOST=0.0.0.0

# Storage backend: "memory" (dev/tests, no persistence) or "postgres"
STORE_BACKEND=memory

# Required when STORE_BACKEND=postgres: the connection the server runs with.
DATABASE_URL=postgres://ce:ce@localhost:5432/collect_earth_cloud

# Advised in production: the tables' owner, used only for the migrations. Then
# DATABASE_URL names a separate role (e.g. ce_app), which the migrations create if
# missing and grant the tables, so the database's project rules (Row-Level
# Security) bind the server. See DEPLOY.md, "Row-Level Security and the database role".
# MIGRATION_DATABASE_URL=postgres://ce:ce@localhost:5432/collect_earth_cloud

# Lets scripts provision projects with header x-admin-key (POST /v1/projects).
# Logged-in dashboard users create projects with their session instead. Without
# a key, anonymous provisioning works ONLY with STORE_BACKEND=memory (dev/tests).
ADMIN_API_KEY=

# Public HTTPS base URL of this server, for /join/<token> and /reset/<token> links
# and every link in an email, e.g. https://ce-cloud.example.org. Required with
# SMTP_URL. If unset: RENDER_EXTERNAL_URL (set by Render), else (screens only, never
# emails) the request's protocol (x-forwarded-proto) and its Host header.
PUBLIC_BASE_URL=

# "true" (or 1): links derived from a request use X-Forwarded-Host instead of Host.
# Only behind a proxy that sets that header itself: a client can write it. Default off.
# TRUST_FORWARDED_HOST=false

# Signs the Collect Earth backup's download links and the emails' unsubscribe and
# confirmation links (32+ characters; required with SMTP_URL). Without it the backup
# links use a key worked out from DATABASE_URL (a random one per process with the
# memory store). Generate one: openssl rand -base64 32. A secret.
# LINK_SECRET=

# First-run setup code, asked for once by the dashboard to create the platform
# admin. If unset, a random code is generated at boot and printed in the log
# ("Setup code: XXXX-XXXX-XX") until setup is done.
SETUP_CODE=

# Requests per minute per client IP on login/signup/setup/reset/register
# (default 60; failed logins are also limited to 10 per minute per account;
# 0 turns both off).
RATE_LIMIT_PER_MINUTE=

# Proxies in front of the server that add to x-forwarded-for (default 1). The
# client IP for rate limiting is read that many entries from the right.
TRUST_PROXY_HOPS=

# Memory, in MB, the thread computing the quality figures may use (default 256,
# at least 64). A project too big for it gets a plain error instead of the figures.
# QUALITY_WORKER_MAX_MB=256

# The server's heap in MB. Read by the Docker image's start command, which passes it
# to Node as --max-old-space-size (default 224 for 512 MiB; 448 for 1 GiB). Not read
# by `npm run dev`. See DEPLOY.md, "Memory".
# NODE_HEAP_MB=224

# Memory caches, per instance (DEPLOY.md, "Memory"; the 1 GiB values in brackets):
# parsed plot files, in MB, at least 8 (default 96 [384])
# PARSED_FILES_CACHE_MB=96
# plot files built for people, in MB, at least 8 (default 32 [128])
# SERVED_FILES_CACHE_MB=32
# maps kept for their next pages, at least 1 (default 4 [8])
# MAP_BUILDS_KEPT=4
# projects whose Progress and People state is kept, at least 1 (default 3 [6])
# PROJECT_STATES_KEPT=3

# The base map of the dashboard's map of progress (default: OpenStreetMap's own
# tiles). An https tile URL with {z}, {x} and {y}; the attribution is required with
# it (plain text the tile source asks to show, at most 300 characters); the
# attribution link and the deepest zoom (1-22, default 19) are optional. See
# DEPLOY.md, "The map's base map".
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# MAP_TILE_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
# MAP_TILE_MAX_ZOOM=19

# Weekly emails (optional, off by default). Without SMTP_URL no email is sent: the
# log gets one line per mail instead. smtps://user:password@host:465 (TLS) or
# smtp://user:password@host:587 (STARTTLS, required); plain smtp:// only to localhost.
# A secret (it holds the password). With it, MAIL_FROM, PUBLIC_BASE_URL and
# LINK_SECRET are required, or the server does not start. See DEPLOY.md,
# "Weekly emails (optional)".
# SMTP_URL=
# The address the emails come from: noreply@example.org or Name <noreply@example.org>.
# MAIL_FROM=Collect Earth Cloud <noreply@example.org>
# The weekly job (POST /v1/internal/digest) may send this in x-digest-secret
# (32+ characters, a secret)...
# DIGEST_SECRET=
# ...or come with Cloud Scheduler's OIDC token for this audience and this service
# account (both together). With neither way set, the endpoint is off (404).
# DIGEST_OIDC_AUDIENCE=https://ce-cloud.example.org/v1/internal/digest
# DIGEST_OIDC_EMAIL=ce-scheduler@<PROJECT>.iam.gserviceaccount.com

# AI assistant (Gemini on Vertex AI), optional and off by default. The server can
# reach Vertex AI with an API key, or as its Cloud Run service account (with the
# "Vertex AI User" role) given the Google Cloud project. Then the platform admin
# switches it on in the server settings, and each coordinator for their project.
# The key is a secret: keep it in Secret Manager; it is never shown or logged.
# AI_VERTEX_API_KEY=
# AI_VERTEX_PROJECT=
# Vertex AI location (default global).
# AI_VERTEX_REGION=global
# The Gemini model id on Vertex AI (default gemini-3.8-flash, Gemini 3.8 Flash).
# AI_MODEL=gemini-3.8-flash
# Never set GOOGLE_VERTEX_BASE_URL or GOOGLE_GEMINI_BASE_URL: the Google SDK would
# send its requests, with the key, to that address. See DEPLOY.md, "AI assistant".
# Development only: AI_FAKE=1 wires a scripted stand-in for the model (never Vertex),
# accepted only with STORE_BACKEND=memory.
# AI_FAKE=1

# When "true" (or 1), apply pending SQL migrations on boot before listening (requires
# STORE_BACKEND=postgres). Safe with several instances: migrations run under a
# Postgres advisory lock.
MIGRATE_ON_BOOT=false
